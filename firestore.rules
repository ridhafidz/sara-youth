rules_version = '2';

// Security Rules SARA Youth
// Prinsip: seluruh mahasiswa terautentikasi boleh MEMBACA data program
// (karena transparansi adalah inti SDG 16), tetapi MENULIS hanya boleh
// dilakukan oleh pemilik data atau admin.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // Collections
    // ---------------------------------------------------------------

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(userId);
    }

    match /sdg_programs/{programId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Any signed in user can create a program
      allow update, delete: if isAdmin() || isOwner(resource.data.createdBy) || isOwner(request.resource.data.createdBy);
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
